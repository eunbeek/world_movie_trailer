rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Functions use the Admin SDK and do not depend on these client rules.
    // Apps only need read access to the published JSON documents.
    match /{fileName} {
      allow read: if fileName.matches('movies_.*[.]json')
                  || fileName == 'quotes_special.json'
                  || fileName == 'promotion_url.json'
                  || fileName == 'hotFixMode.json';
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
